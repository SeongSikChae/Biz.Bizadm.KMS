<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>Biz.Bizadm.KMS.Credentials</PackageId>
    <Version>1.0.2</Version>
    <Authors>SeongSikChae</Authors>
    <Description>OS credential-store IKekCredentialProvider facade with RID-specific runtime implementations.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biz.Bizadm.KMS\Biz.Bizadm.KMS.csproj" />
    <ProjectReference Include="..\Biz.Bizadm.KMS.Credentials\Biz.Bizadm.KMS.Credentials.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Biz.Bizadm.KMS.Credentials.Runtime.win\Biz.Bizadm.KMS.Credentials.Runtime.win.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Biz.Bizadm.KMS.Credentials.Runtime.linux\Biz.Bizadm.KMS.Credentials.Runtime.linux.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Biz.Bizadm.KMS.Credentials.Runtime.osx\Biz.Bizadm.KMS.Credentials.Runtime.osx.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Devlooped.CredentialManager" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\Biz.Bizadm.KMS.Credentials\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.dll"
          Pack="true"
          PackagePath="lib\net10.0;runtimes\win\lib\net10.0;runtimes\linux\lib\net10.0;runtimes\osx\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.pdb"
          Pack="true"
          PackagePath="lib\net10.0;runtimes\win\lib\net10.0;runtimes\linux\lib\net10.0;runtimes\osx\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.xml"
          Pack="true"
          PackagePath="lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials.Runtime.win\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.Runtime.dll"
          Pack="true"
          PackagePath="runtimes\win\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials.Runtime.win\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.Runtime.pdb"
          Pack="true"
          PackagePath="runtimes\win\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials.Runtime.linux\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.Runtime.dll"
          Pack="true"
          PackagePath="runtimes\linux\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials.Runtime.linux\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.Runtime.pdb"
          Pack="true"
          PackagePath="runtimes\linux\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials.Runtime.osx\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.Runtime.dll"
          Pack="true"
          PackagePath="runtimes\osx\lib\net10.0" />
    <None Include="..\Biz.Bizadm.KMS.Credentials.Runtime.osx\bin\$(Configuration)\net10.0\Biz.Bizadm.KMS.Credentials.Runtime.pdb"
          Pack="true"
          PackagePath="runtimes\osx\lib\net10.0" />
  </ItemGroup>

</Project>
